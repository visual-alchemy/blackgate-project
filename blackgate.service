# systemd unit template for the blackgate dev/release daemon.
# NOT installed directly — run `make systemd-install`, which substitutes
# @USER@ (running user) and @DIR@ (repo checkout path) and installs the
# result to /etc/systemd/system/blackgate.service.

[Unit]
Description=Blackgate SRT Gateway
After=network.target

[Service]
Type=exec
User=@USER@
Group=@USER@
WorkingDirectory=@DIR@
Environment=PHX_SERVER=true
Environment=PORT=4000
Environment=PHX_HOST=0.0.0.0
Environment=API_AUTH_USERNAME=admin
Environment=API_AUTH_PASSWORD=password123
Environment=LICENSE_SERVER_URL=https://license-server-eta-bay.vercel.app
Environment=RELEASE_COOKIE=blackgate_production_cookie
Environment=BLACKGATE_HW_DECODE=1
ExecStart=@DIR@/_build/prod/rel/blackgate/bin/blackgate start
ExecStop=@DIR@/_build/prod/rel/blackgate/bin/blackgate stop
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
