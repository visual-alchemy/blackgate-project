[Unit]
Description=Blackgate SRT Gateway
After=network.target

[Service]
Type=exec
User=woi
Group=woi
WorkingDirectory=/home/woi/Downloads/blackgate-project
Environment=PHX_SERVER=true
Environment=PORT=4000
Environment=PHX_HOST=0.0.0.0
Environment=API_AUTH_USERNAME=admin
Environment=API_AUTH_PASSWORD=password123
Environment=LICENSE_SERVER_URL=https://license-server-eta-bay.vercel.app
Environment=RELEASE_COOKIE=blackgate_production_cookie
ExecStart=/home/woi/Downloads/blackgate-project/_build/prod/rel/blackgate/bin/blackgate start
ExecStop=/home/woi/Downloads/blackgate-project/_build/prod/rel/blackgate/bin/blackgate stop
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
