#cloud-config
autoinstall:
  version: 1

  # ─── Locale & keyboard ─────────────────────────────────────────────
  locale: en_US.UTF-8
  keyboard:
    layout: us

  # ─── Disk layout — auto LVM, use entire first disk ─────────────────
  storage:
    layout:
      name: lvm
      sizing-policy: all

  # ─── User account ───────────────────────────────────────────────────
  identity:
    hostname: blackgate
    username: blackgate
    password: "$6$DW0zy6128MQOaqTY$NEOd3yZuWNEnNy63QbvqPio9GMpBx9NHWOnBAyUIjhrawA933b57WmeAgKy2qCXzAwAYDCKLGXNE67Oj2SFVj/"

  # ─── SSH ────────────────────────────────────────────────────────────
  ssh:
    install-server: true
    allow-pw: true

  # ─── Packages to install (bare-metal runtime dependencies) ─────────
  packages:
    - curl
    - net-tools
    - htop
    - ca-certificates
    - libssl3t64
    - libncurses6
    - libstdc++6
    - ffmpeg
    - libgstreamer1.0-0
    - libgstreamer-plugins-base1.0-0
    - gstreamer1.0-tools
    - gstreamer1.0-plugins-base
    - gstreamer1.0-plugins-good
    - gstreamer1.0-plugins-bad
    - gstreamer1.0-libav
    - gstreamer1.0-vaapi
    - libsrt1.5-gnutls
    - libcjson1
    - iproute2
    # DeckLink driver prerequisites: the vendor .deb builds its kernel modules through DKMS.
    - dkms
    - linux-headers-generic
    - libgl1

  # ─── Disable snaps ──────────────────────────────────────────────────
  snaps: []

  # ─── Late commands — run after install, before reboot ───────────────
  late-commands:
    # ─── Support access: key-only SSH, two doors (root + bg-support) ───────────────────────────────
    # The public key in iso-builder/files/support-authorized-keys belongs to the vendor. Nobody gets a
    # password: one that is identical on every appliance is worse than no password at all.
    - curtin in-target -- usermod -s /bin/bash root
    - curtin in-target -- mkdir -p /root/.ssh
    - curtin in-target -- chmod 700 /root/.ssh
    - cp /cdrom/blackgate/support-authorized-keys /target/root/.ssh/authorized_keys
    - curtin in-target -- chmod 600 /root/.ssh/authorized_keys

    # Root keeps one randomly generated password, for the physical console only (break-glass). SSH for root
    # is key-only, so this password never travels over the network.
    - |
      curtin in-target -- bash -c 'umask 077; ROOT_PW=$(head -c 18 /dev/urandom | base64); echo "root:$ROOT_PW" | chpasswd; { echo "Blackgate break-glass root password (physical console only - root SSH is key-only)"; echo "user: root"; echo "password: $ROOT_PW"; } > /root/blackgate-root-password.txt; chmod 600 /root/blackgate-root-password.txt'
    - curtin in-target -- sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config

    # bg-support: the day-to-day support door. Key-only, sudo for debugging, locked if the key is removed.
    - curtin in-target -- useradd -m -s /bin/bash bg-support
    - curtin in-target -- passwd -l bg-support
    - curtin in-target -- usermod -aG sudo bg-support
    - mkdir -p /target/home/bg-support/.ssh
    - cp /cdrom/blackgate/support-authorized-keys /target/home/bg-support/.ssh/authorized_keys
    - chmod 700 /target/home/bg-support/.ssh
    - chmod 600 /target/home/bg-support/.ssh/authorized_keys
    - curtin in-target -- chown -R bg-support:bg-support /home/bg-support/.ssh
    - |
      curtin in-target -- bash -c 'printf "%s\n" "bg-support ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/99-blackgate-support; chmod 0440 /etc/sudoers.d/99-blackgate-support; visudo -c -f /etc/sudoers.d/99-blackgate-support || rm -f /etc/sudoers.d/99-blackgate-support'

    # Remove sudo access for the application user (the client drives the dashboard, not the shell)
    - curtin in-target -- bash -c 'deluser blackgate sudo || true'

    # Create required directories
    - mkdir -p /target/opt/blackgate
    - mkdir -p /target/var/lib/blackgate/khepri
    - mkdir -p /target/etc/update-motd.d
    - mkdir -p /target/usr/lib/x86_64-linux-gnu/gstreamer-1.0

    # Copy Blackgate files from ISO to installed system
    - cp /cdrom/blackgate/blackgate-release.tar.gz /target/opt/blackgate/
    - cp /cdrom/blackgate/blackgate.service /target/etc/systemd/system/
    - cp /cdrom/blackgate/blackgate-firstboot.service /target/etc/systemd/system/
    - cp /cdrom/blackgate/blackgate-firstboot.sh /target/opt/blackgate/
    - cp /cdrom/blackgate/99-blackgate-motd.sh /target/etc/update-motd.d/99-blackgate
    - cp /cdrom/blackgate/libgstdecklink.so /target/usr/lib/x86_64-linux-gnu/gstreamer-1.0/

    # System-tab integration: first boot installs these with blackgate-install-system-actions.sh
    - mkdir -p /target/opt/blackgate/files
    - cp /cdrom/blackgate/blackgate-system-action /target/opt/blackgate/files/
    - cp /cdrom/blackgate/blackgate-system-action.sudoers /target/opt/blackgate/files/
    - cp /cdrom/blackgate/blackgate-updater /target/opt/blackgate/files/
    - cp /cdrom/blackgate/blackgate.service /target/opt/blackgate/files/
    - cp /cdrom/blackgate/release-version /target/opt/blackgate/
    - cp /cdrom/blackgate/support-authorized-keys /target/opt/blackgate/files/
    - |
      [ -f /cdrom/blackgate/blackmagic-desktopvideo.deb ] && cp /cdrom/blackgate/blackmagic-desktopvideo.deb /target/opt/blackgate/files/ || echo 'no Desktop Video deb on this image'
    - cp /cdrom/blackgate/blackgate-install-system-actions.sh /target/opt/blackgate/

    # Set permissions
    - chmod +x /target/opt/blackgate/blackgate-firstboot.sh
    - chmod +x /target/opt/blackgate/blackgate-install-system-actions.sh
    - chmod +x /target/etc/update-motd.d/99-blackgate
    - chmod 644 /target/usr/lib/x86_64-linux-gnu/gstreamer-1.0/libgstdecklink.so
    - chown -R 1000:1000 /target/opt/blackgate
    - chown -R 1000:1000 /target/var/lib/blackgate

    # Enable services via manual symlinks
    - mkdir -p /target/etc/systemd/system/multi-user.target.wants
    - ln -sf /lib/systemd/system/ssh.service /target/etc/systemd/system/multi-user.target.wants/ssh.service
    - ln -sf /etc/systemd/system/blackgate-firstboot.service /target/etc/systemd/system/multi-user.target.wants/blackgate-firstboot.service

    # Configure netplan for DHCP
    - rm -f /target/etc/netplan/*.yaml /target/etc/netplan/*.yml
    - |
      cat > /target/etc/netplan/01-blackgate.yaml << 'EOF'
      network:
        version: 2
        renderer: networkd
        ethernets:
          all-eth:
            match:
              name: "e*"
            dhcp4: true
            optional: true
      EOF
    - chmod 600 /target/etc/netplan/01-blackgate.yaml

  reboot-on-finish: true
