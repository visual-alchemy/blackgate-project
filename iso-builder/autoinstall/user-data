#cloud-config
autoinstall:
  version: 1

  # ─── Locale & keyboard ─────────────────────────────────────────────
  locale: en_US.UTF-8
  keyboard:
    layout: us

  # Install from media only. Mirror failure must never block appliance setup.
  apt:
    geoip: false
    mirror-selection:
      # Force Subiquity's documented offline fallback. This appliance carries
      # every required package on the ISO and must not upgrade from a LAN.
      primary:
        - uri: "http://127.0.0.1:9/ubuntu"
          arches: [amd64]
    fallback: offline-install

  # ─── Disk layout — auto LVM, use entire first disk ─────────────────
  storage:
    layout:
      name: lvm
      sizing-policy: all

  # ─── User account ───────────────────────────────────────────────────
  identity:
    hostname: blackgate
    username: blackgate
    password: "$6$DW0zy6128MQOaqTY$NEOd3yZuWNEnNy63QbvqPio9GMpBx9NHWOnBAyUIjhrawA933b57WmeAgKy2qCXzAwAYDCKLGXNE67Oj2SFVj/"

  # ─── SSH ────────────────────────────────────────────────────────────
  ssh:
    install-server: true
    allow-pw: true

  # ─── Disable snaps ──────────────────────────────────────────────────
  snaps: []

  # ─── Late commands — run after install, before reboot ───────────────
  late-commands:
    # Enable root login for developers (password: blackgate212514)
    - curtin in-target -- usermod -s /bin/bash root
    - curtin in-target -- usermod -p '$6$BGdev2025salt$JSPuWJdO5tqqc8Nv9IrKJZdX24RgSe9tn4hJZzkmfT81j4umd8/xZbYI1.r9F661HjS.YhwycOXtMsHijBtCP/' root
    - curtin in-target -- sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config

    # Remove sudo access for blackgate user (client has no root)
    - curtin in-target -- bash -c 'deluser blackgate sudo || true'

    # Create required directories
    - mkdir -p /target/opt/blackgate
    - mkdir -p /target/var/lib/blackgate/khepri
    - mkdir -p /target/etc/update-motd.d
    - mkdir -p /target/usr/local/libexec /target/etc/sudoers.d

    # Copy Blackgate files from ISO to installed system
    - cp /cdrom/blackgate/blackgate-release.tar.gz /target/opt/blackgate/
    - cp /cdrom/blackgate/blackgate.service /target/etc/systemd/system/
    - cp /cdrom/blackgate/blackgate-firstboot.service /target/etc/systemd/system/
    - cp /cdrom/blackgate/blackgate-firstboot.sh /target/opt/blackgate/
    - cp /cdrom/blackgate/desktopvideo_16.0.1a2_amd64.deb /target/opt/blackgate/
    - cp /cdrom/blackgate/decklink-profile-config /target/opt/blackgate/
    - cp /cdrom/blackgate/99-blackgate-motd.sh /target/etc/update-motd.d/99-blackgate
    - cp /cdrom/blackgate/blackgate-system-action /target/usr/local/libexec/blackgate-system-action
    - cp /cdrom/blackgate/blackgate-updater /target/usr/local/libexec/blackgate-updater
    - cp /cdrom/blackgate/blackgate-system-action.sudoers /target/etc/sudoers.d/blackgate-system-action
    - mkdir -p /target/etc/blackgate
    - cp /cdrom/blackgate/blackgate-update-public.pem /target/etc/blackgate/update-public-key.pem
    - cp -a /cdrom/blackgate/offline-repo /target/opt/blackgate/

    # Install runtime and DKMS dependencies exclusively from bundled media.
    - mkdir -p /target/etc/apt/blackgate-empty-sources.list.d
    - |
      cat > /target/etc/apt/sources.list.d/blackgate-offline.list << 'EOF'
      deb [trusted=yes] file:/opt/blackgate/offline-repo ./
      EOF
    - curtin in-target -- apt-get -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/blackgate-offline.list -o Dir::Etc::sourceparts=/etc/apt/blackgate-empty-sources.list.d update
    - curtin in-target -- apt-get -o Dir::Etc::sourcelist=/etc/apt/sources.list.d/blackgate-offline.list -o Dir::Etc::sourceparts=/etc/apt/blackgate-empty-sources.list.d --no-install-recommends -y install build-essential dkms gstreamer1.0-libav gstreamer1.0-plugins-bad gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-tools libcjson1 libgl1 net-tools linux-headers-generic /opt/blackgate/desktopvideo_16.0.1a2_amd64.deb

    # Set permissions
    - chmod +x /target/opt/blackgate/blackgate-firstboot.sh
    - chmod +x /target/opt/blackgate/decklink-profile-config
    - chmod +x /target/etc/update-motd.d/99-blackgate
    - chmod 0750 /target/usr/local/libexec/blackgate-system-action
    - chmod 0750 /target/usr/local/libexec/blackgate-updater
    - chmod 0440 /target/etc/sudoers.d/blackgate-system-action
    - chmod 0644 /target/etc/blackgate/update-public-key.pem
    - chown -R 1000:1000 /target/opt/blackgate
    - chown -R 1000:1000 /target/var/lib/blackgate

    # Enable services via manual symlinks
    - mkdir -p /target/etc/systemd/system/multi-user.target.wants
    - ln -sf /lib/systemd/system/ssh.service /target/etc/systemd/system/multi-user.target.wants/ssh.service
    - ln -sf /etc/systemd/system/blackgate-firstboot.service /target/etc/systemd/system/multi-user.target.wants/blackgate-firstboot.service

    # Configure netplan for DHCP
    - rm -f /target/etc/netplan/*.yaml /target/etc/netplan/*.yml
    - |
      cat > /target/etc/netplan/01-blackgate.yaml << 'EOF'
      network:
        version: 2
        renderer: networkd
        ethernets:
          all-eth:
            match:
              name: "en*"
            dhcp4: true
            optional: true
      EOF
    - chmod 600 /target/etc/netplan/01-blackgate.yaml

  reboot-on-finish: true
