#!/bin/sh
# Blackgate privileged system actions, invoked by the dashboard through sudo.
#
# Every action is *scheduled* with systemd-run instead of executed directly, so an operator who clicked
# the wrong button (or a dashboard that repeated a request) still has a window to cancel the transient
# unit before the box goes down:
#
#     restart 15 s     reboot 60 s     shutdown 60 s     deploy 15 s
#
# Two properties together make that window what the tooltip says it is:
#
#   * --on-active=<n>s sets the delay, and
#   * --timer-property=AccuracySec=1s pins the timer's accuracy. Without it the transient timer inherits
#     systemd's default AccuracyUSec=1min, and systemd is then free to start the unit up to a minute
#     after the elapse: a measured "10 s delay" actually ran 44 s after the click. The delays here, the
#     tooltips in Settings > System (web_app/src/pages/Settings.jsx) and the table in
#     docs/operations/system-actions-and-updates.md must be kept in step.
#
# Cancel with:
#
#     blackgate-system-action cancel blackgate-dashboard-reboot
#
# The unit is the only interface: no shell, no arbitrary command, no path from the dashboard.
set -eu

SYSTEMD_RUN=/usr/bin/systemd-run
SYSTEMCTL=/usr/bin/systemctl
UPDATER=/usr/local/libexec/blackgate-updater
SERVICE=blackgate.service
# Every scheduled action passes this, so the delay in the tooltip is the delay that happens.
TIMER_ACCURACY=--timer-property=AccuracySec=1s

die() {
  echo "$1" >&2
  exit "${2:-64}"
}

version_ok() {
  printf '%s' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'
}

case "${1:-}" in
  restart-blackgate)
    exec "$SYSTEMD_RUN" --quiet --collect --unit=blackgate-dashboard-restart \
      "$TIMER_ACCURACY" --on-active=15s "$SYSTEMCTL" restart "$SERVICE"
    ;;
  reboot)
    exec "$SYSTEMD_RUN" --quiet --collect --unit=blackgate-dashboard-reboot \
      "$TIMER_ACCURACY" --on-active=60s "$SYSTEMCTL" reboot
    ;;
  shutdown)
    exec "$SYSTEMD_RUN" --quiet --collect --unit=blackgate-dashboard-shutdown \
      "$TIMER_ACCURACY" --on-active=60s "$SYSTEMCTL" poweroff
    ;;
  cancel)
    case "${2:-}" in
      blackgate-dashboard-restart | blackgate-dashboard-reboot | blackgate-dashboard-shutdown | \
      blackgate-dashboard-deploy | blackgate-dashboard-test) ;;
      *) die "unknown unit" ;;
    esac
    # --on-active creates a transient timer plus the service it will start: stopping the timer is
    # what prevents the action, stopping the service covers the case where it already fired.
    "$SYSTEMCTL" stop "$2.timer" 2>/dev/null || true
    "$SYSTEMCTL" stop "$2.service" 2>/dev/null || true
    exit 0
    ;;
  deploy)
    version="${2:-}"
    version_ok "$version" || die "invalid version"
    exec "$SYSTEMD_RUN" --quiet --collect --unit=blackgate-dashboard-deploy \
      "$TIMER_ACCURACY" --on-active=15s "$UPDATER" deploy "$version"
    ;;
  test-action)
    # Plumbing smoke test: schedules a harmless transient unit through exactly the same mechanism the
    # destructive actions use, so sudoers + systemd-run + cancel can be proven before anyone trusts a
    # reboot button. It does nothing after 60 s.
    exec "$SYSTEMD_RUN" --quiet --collect --unit=blackgate-dashboard-test \
      "$TIMER_ACCURACY" --on-active=60s /bin/true
    ;;
  *)
    die "Unsupported Blackgate system action"
    ;;
esac
