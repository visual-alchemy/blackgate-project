#!/bin/sh
set -eu
ROOT=/opt/blackgate
INCOMING="$ROOT/incoming"
RELEASES="$ROOT/releases"
CURRENT="$ROOT/current"
KEY=/etc/blackgate/update-public-key.pem
STATUS=/run/blackgate-update-status
KEEP_RELEASES=5
status() { echo "$1" > "$STATUS"; }
fail() { status "failed: $1"; echo "$1" >&2; exit 1; }
prune_releases() {
  current_version="$(readlink "$CURRENT" | sed 's#^.*/##')"
  kept=0
  find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%T@:%f\n' | sort -t: -k1,1nr | cut -d: -f2- |
    while IFS= read -r version; do
      case "$version" in ''|*[!A-Za-z0-9._-]*) continue ;; esac
      [ "$version" = "$current_version" ] && continue
      if [ "$kept" -lt $((KEEP_RELEASES - 1)) ]; then kept=$((kept + 1)); else rm -rf -- "$RELEASES/$version"; fi
    done
}
[ "${1:-}" = deploy ] || fail "unsupported command"
VERSION="${2:-}"
echo "$VERSION" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$' || fail "invalid version"
PACKAGE="$INCOMING/$VERSION.bgupdate"
[ -f "$PACKAGE" ] && [ -f "$KEY" ] || fail "package or verification key missing"
WORK="$(mktemp -d /var/tmp/blackgate-update.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT
tar tzf "$PACKAGE" | grep -qx manifest.txt || fail "manifest missing"
tar tzf "$PACKAGE" | grep -qx manifest.sig || fail "signature missing"
tar tzf "$PACKAGE" | grep -qx blackgate-release.tar.gz || fail "release missing"
tar xzf "$PACKAGE" -C "$WORK" manifest.txt manifest.sig blackgate-release.tar.gz || fail "archive extraction failed"
openssl pkeyutl -verify -pubin -inkey "$KEY" -rawin -in "$WORK/manifest.txt" -sigfile "$WORK/manifest.sig" >/dev/null 2>&1 || fail "signature verification failed"
PRODUCT="$(awk -F= '$1=="product" {print $2}' "$WORK/manifest.txt")"
MANIFEST_VERSION="$(awk -F= '$1=="version" {print $2}' "$WORK/manifest.txt")"
PLATFORM="$(awk -F= '$1=="platform" {print $2}' "$WORK/manifest.txt")"
EXPECTED_SHA="$(awk -F= '$1=="release_sha256" {print $2}' "$WORK/manifest.txt")"
[ "$PRODUCT" = blackgate ] && [ "$MANIFEST_VERSION" = "$VERSION" ] && [ "$PLATFORM" = ubuntu-24.04-amd64 ] || fail "manifest rejected"
echo "$EXPECTED_SHA  $WORK/blackgate-release.tar.gz" | sha256sum -c - >/dev/null 2>&1 || fail "release checksum failed"

# New signed packages carry the root updater too. Verify it now, then install
# only after new release passes its service health check. Optional for legacy
# packages so old retained updates remain deployable.
UPDATER_SHA="$(awk -F= '$1=="updater_sha256" {print $2}' "$WORK/manifest.txt")"
if tar tzf "$PACKAGE" | grep -qx blackgate-updater; then
  [ -n "$UPDATER_SHA" ] || fail "updater checksum missing"
  tar xzf "$PACKAGE" -C "$WORK" blackgate-updater || fail "updater extraction failed"
  echo "$UPDATER_SHA  $WORK/blackgate-updater" | sha256sum -c - >/dev/null 2>&1 || fail "updater checksum failed"
else
  [ -z "$UPDATER_SHA" ] || fail "updater missing"
fi
status "deploying: $VERSION"
PREVIOUS="$(readlink "$CURRENT")"
if [ -e "$RELEASES/$VERSION" ]; then
  status "rolling back: $VERSION"
else
  mkdir -p "$RELEASES/$VERSION"
  tar xzf "$WORK/blackgate-release.tar.gz" -C "$RELEASES/$VERSION" --strip-components=1 || fail "release extraction failed"
  chown -R blackgate:blackgate "$RELEASES/$VERSION"
fi
ln -s "releases/$VERSION" "$ROOT/current.next"
mv -Tf "$ROOT/current.next" "$CURRENT"
systemctl restart blackgate.service
sleep 8
if systemctl is-active --quiet blackgate.service; then
  prune_releases
  if [ -f "$WORK/blackgate-updater" ]; then
    UPDATER_PATH=/usr/local/libexec/blackgate-updater
    UPDATER_NEXT="$UPDATER_PATH.next"
    UPDATER_BACKUP="$UPDATER_PATH.backup-$VERSION"
    if [ -f "$UPDATER_PATH" ] && ! cp -p "$UPDATER_PATH" "$UPDATER_BACKUP"; then
      status "deployed: $VERSION (updater backup failed)"
      echo "WARNING: release deployed, but root updater backup failed" >&2
      exit 0
    fi
    if install -o root -g root -m 0750 "$WORK/blackgate-updater" "$UPDATER_NEXT" &&
       mv -f "$UPDATER_NEXT" "$UPDATER_PATH"; then
      status "deployed: $VERSION"
    else
      rm -f "$UPDATER_NEXT"
      status "deployed: $VERSION (updater refresh failed)"
      echo "WARNING: release deployed, but root updater refresh failed" >&2
    fi
  else
    status "deployed: $VERSION"
  fi
  exit 0
fi
ln -s "$PREVIOUS" "$ROOT/current.next"
mv -Tf "$ROOT/current.next" "$CURRENT"
systemctl restart blackgate.service || true
fail "new release failed; rolled back"
