[Unit]
Description=Blackgate SRT Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=blackgate
Group=blackgate
# The release the `current` symlink points at: an update swaps the symlink, so this unit never changes.
WorkingDirectory=/opt/blackgate/current

# Credentials live in a root-owned 0600 environment file. A unit file is world-readable, so putting
# API_AUTH_PASSWORD in here would hand the dashboard password to every local user.
EnvironmentFile=-/etc/blackgate/blackgate.env
Environment=PHX_SERVER=true
Environment=PORT=4000
Environment=PHX_HOST=0.0.0.0
Environment=HOME=/opt/blackgate/current
Environment=DATABASE_DATA_DIR=/var/lib/blackgate/khepri
# Quoted: systemd splits an unquoted Environment value on whitespace, which would silently set
# ERL_AFLAGS=-proto_dist and drop the argument (and make the node refuse to start).
Environment="ERL_AFLAGS=-proto_dist inet_tcp"
# RELEASE_DISTRIBUTION=none is deliberately NOT set. Khepri names its store directory after the node
# (`<data dir>` holds an Ra system whose membership records that node), and `bin/blackgate rpc`/`pid`
# need distribution too. Turning it off makes the node anonymous, which is how a gateway can come up
# against a fresh empty database while the real one sits on disk.
Environment=RELEASE_NODE=blackgate

# A leftover socket file from a previous run makes the Ranch unix listener fail to bind.
ExecStartPre=-/bin/rm -f /tmp/hydra_unix_sock
ExecStart=/opt/blackgate/current/bin/blackgate start
ExecStop=/opt/blackgate/current/bin/blackgate stop

Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
